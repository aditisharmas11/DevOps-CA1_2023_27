{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/njs2017/agent-action-contract/blob/main/src/agent_action_contract/action-contract.schema.json",
  "title": "Agent Action Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "description", "actor", "delegation", "capability",
    "effect", "resources", "risk", "approval", "recovery", "notification",
    "cost", "evidence"
  ],
  "properties": {
    "version": {"const": "1"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "description": {"type": "string", "minLength": 1},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["agent", "service", "human"]}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal"],
      "properties": {
        "principal": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "capability": {"type": "string", "minLength": 1},
    "effect": {"enum": ["read", "write", "destructive"]},
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["none", "implicit", "explicit"]}}
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reversible"],
      "properties": {
        "reversible": {"type": "boolean"},
        "undo": {"type": "string", "minLength": 1}
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing"],
      "properties": {"timing": {"enum": ["none", "before", "after"]}}
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["free", "paid"]},
        "max_amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 3, "maxLength": 3}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs"],
      "properties": {
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
